# Copy to .env (gitignored) and fill in. Names only here — never real values.
# Values are read through engine.core.env.get_secret(), which masks them in repr/logs.

# free (default) | paid
MODE=free

# v1_shadow (default: Human-in-the-Loop Shadow Order Book Scanner) | v2_bot (Automated Strategy Bots)
ENGINE_VERSION=

# --- M2 data feed: Upstox API V3 (free; `full` mode = 5-level depth + OI; `full_d30` needs Upstox Plus) ---
# Generate 1-year read-only Analytics Token in Upstox Developer Console (My Account -> Apps -> Analytics Token)
UPSTOX_ANALYTICS_TOKEN=
# Written by `tasks.py upstox-login` (daily); only needed if the analytics token is refused
UPSTOX_ACCESS_TOKEN=
UPSTOX_TOKEN_DATE=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# --- Mode A fallback data: Fyers (free plan: 100 symbols) ---
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_CLIENT_ID=
FYERS_TOTP_SECRET=
# Written by `tasks.py fyers-login` each morning (do not fill by hand)
FYERS_ACCESS_TOKEN=
FYERS_TOKEN_DATE=

# --- Mode A fallbacks ---
SHOONYA_USER_ID=
SHOONYA_API_KEY=
SHOONYA_VENDOR_CODE=
SHOONYA_TOTP_SECRET=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_TOTP_SECRET=

# --- Mode B (paid): Dhan or Zerodha Kite ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
KITE_API_KEY=
KITE_API_SECRET=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
